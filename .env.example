# Copy this file to .env and fill in the real values from the Fasthosts
# control panel once hosting is live. .env is git-ignored; never commit it.
#
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)

FTP_HOST=ftp.thejaroflife.com
FTP_USER=your-ftp-username
FTP_PASSWORD=your-ftp-password
FTP_PORT=21

# Optional. Folder on the server that serves the website.
# Fasthosts Linux hosting normally uses "htdocs" — confirm in the control panel.
FTP_REMOTE_DIR=htdocs

# Optional. "true" = encrypted FTPS (recommended). Set to "false" only if
# Fasthosts' FTP server refuses TLS connections.
FTP_TLS=true
