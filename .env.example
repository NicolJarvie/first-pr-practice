# Copy this file to .env and fill in the real values from the Fasthosts
# control panel once hosting is live. .env is git-ignored; never commit it.
#
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)

FTP_HOST=ftp.fasthosts.co.uk
FTP_USER=thejaroflife.com
FTP_PASSWORD=your-ftp-password
FTP_PORT=21

# Optional. Folder to change into after logging in. Leave BLANK for Fasthosts:
# the FTP login already lands inside htdocs (the web root), so "htdocs" here
# fails with "550 Not a valid directory".
FTP_REMOTE_DIR=

# Optional. "true" = encrypted FTPS (recommended). Set to "false" only if
# Fasthosts' FTP server refuses TLS connections.
FTP_TLS=true
